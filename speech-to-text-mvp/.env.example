# Deepgram API Key (for STT + TTS)
# Get your API key from: https://console.deepgram.com/
VITE_DEEPGRAM_API_KEY=your_deepgram_key_here

# Groq API Key (for LLM chat — llama-3.3-70b)
# Get your API key from: https://console.groq.com/
VITE_GROQ_API_KEY=your_groq_key_here

# Google Cloud TTS API Key (for Finnish TTS)
# Get your API key from: https://console.cloud.google.com/ → Enable "Cloud Text-to-Speech API"
VITE_GOOGLE_TTS_KEY=your_google_tts_key_here
